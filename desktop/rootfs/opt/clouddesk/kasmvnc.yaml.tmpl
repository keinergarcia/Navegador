# Configuración de KasmVNC generada por render-config.py en cada arranque.
# No editar a mano dentro del contenedor: se sobrescribe.
desktop:
  resolution:
    width: @WIDTH@
    height: @HEIGHT@
  # Resolución fija: el escritorio NO se redimensiona al tamaño del iPhone.
  # El cliente escala localmente (Settings -> Scaling Mode -> Local Scaling).
  allow_resize: false
  pixel_depth: 24
  gpu:
    hw3d: false

network:
  protocol: http
  interface: 0.0.0.0
  websocket_port: 8444
  use_ipv4: true
  use_ipv6: false
  udp:
    public_ip: 127.0.0.1
    port: auto
  ssl:
    require_ssl: false

user_session:
  session_type: shared
  concurrent_connections_prompt: false
  idle_timeout: never

keyboard:
  ignore_numlock: false
  raw_keyboard: false

pointer:
  enabled: true
  game_mode: false

runtime_configuration:
  allow_client_to_override_kasm_server_settings: true
  allow_override_standard_vnc_server_settings: true
  allow_override_list:
    - pointer.enabled
    - data_loss_prevention.clipboard.server_to_client.enabled
    - data_loss_prevention.clipboard.client_to_server.enabled
    - data_loss_prevention.clipboard.server_to_client.primary_clipboard_enabled

security:
  brute_force_protection:
    blacklist_threshold: 10
    blacklist_timeout: 60

data_loss_prevention:
  clipboard:
    server_to_client:
      enabled: true
      size: 1048576
    client_to_server:
      enabled: true
      size: 1048576
  keyboard:
    enabled: true
    rate_limit: unlimited

encoding:
  max_frame_rate: @MAX_FPS@
  full_frame_updates: none
  rect_encoding_mode:
    min_quality: @QMIN@
    max_quality: @QMAX@
    consider_lossless_quality: 9
    # 2 hilos = 2 OCPU del nivel Always Free de Oracle.
    rectangle_compress_threads: 2
  video_encoding_mode:
    jpeg_quality: -1
    webp_quality: -1
    max_resolution:
      width: 1920
      height: 1200
    enter_video_encoding_mode:
      time_threshold: 5
      area_threshold: 50%
    exit_video_encoding_mode:
      time_threshold: 3
  compare_framebuffer: auto
  hextile_improved_compression: true

server:
  http:
    httpd_directory: /usr/share/kasmvnc/www
  advanced:
    kasm_password_file: /home/desk/.kasmpasswd
    x_authority_file: auto
  auto_shutdown:
    no_user_session_timeout: never
    active_user_session_timeout: never
    inactive_user_session_timeout: never
  allow_environment_variables_to_override_config_settings: false

command_line:
  prompt: false

logging:
  log_dest: logfile
  level: 30
