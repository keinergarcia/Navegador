[Unit]
Description=CloudDesk - renovación de certificados TLS
Documentation=file:///opt/clouddesk/docs/07-operacion.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/clouddesk
ExecStart=/opt/clouddesk/scripts/renew-cert.sh --quiet
TimeoutStartSec=300
Nice=10
