{
  "name": "CloudDesk (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8444],
  "portsAttributes": {
    "8444": {
      "label": "CloudDesk · escritorio KasmVNC",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash scripts/codespaces-up.sh --check-only || true",
  "postStartCommand": "nohup setsid bash scripts/codespaces-boot.sh >/tmp/clouddesk-boot.out 2>&1 &",
  "remoteUser": "vscode"
}
