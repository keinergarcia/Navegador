# =============================================================================
# CloudDesk - plantilla de configuración
# Copia este archivo a .env y ejecuta scripts/bootstrap.sh (recomendado).
# NO escribas secretos reales en este archivo.
# =============================================================================

# --- Identidad y dominios ----------------------------------------------------
# Dominio base que controlas (DNS en Cloudflare, Namecheap, etc.).
BASE_DOMAIN=example.com
# Panel de control (dashboard).
PANEL_HOST=desk.example.com
# Host dedicado al escritorio remoto (KasmVNC). Distinto del panel porque el
# cliente web de KasmVNC no soporta servirse bajo un subdirectorio.
VNC_HOST=vnc.example.com
# Dominio de la cookie de sesión. Debe cubrir ambos hosts.
COOKIE_DOMAIN=.example.com
# Correo para Let's Encrypt (avisos de expiración).
ACME_EMAIL=admin@example.com
TZ=Europe/Madrid

# --- Seguridad (se generan automáticamente) ---------------------------------
# Hash scrypt de la contraseña del panel. Formato: scrypt$N$r$p$salt$hash
AUTH_PASSWORD_HASH=''
# Secreto HMAC para firmar la cookie de sesión (hex, 64 caracteres).
SESSION_SECRET=''
# Token compartido entre el API y el agente del escritorio (hex, 64 caracteres).
AGENT_TOKEN=''
# Credenciales internas de KasmVNC. Nginx inyecta la cabecera Authorization:
# el navegador nunca ve esta contraseña ni abre un diálogo Basic Auth
# (Safari no envía Basic Auth en WebSockets).
VNC_USER=desk
VNC_PASSWORD=''
VNC_AUTH_B64=''

# --- Sesión ------------------------------------------------------------------
# Duración de la sesión del panel en horas.
SESSION_HOURS=12
# Duración cuando se marca "Mantener sesión iniciada" (días).
REMEMBER_DAYS=30
# Intentos de login fallidos antes del bloqueo temporal.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Escritorio --------------------------------------------------------------
# Resolución virtual inicial. KasmVNC NO redimensiona al tamaño del cliente
# (allow_resize=false) para que el escritorio sea estable.
RESOLUTION=1366x768
KASMVNC_MAX_FPS=30
KASMVNC_QUALITY_MIN=6
KASMVNC_QUALITY_MAX=8
# Flags extra para Chromium (separados por espacios).
CHROMIUM_FLAGS=
# Parar la sesión tras N minutos sin actividad ni conexiones VNC (0 = nunca).
IDLE_STOP_MINUTES=30

# --- Recursos ----------------------------------------------------------------
# Límites del contenedor del escritorio. El host Always Free tiene 2 OCPU/12 GB.
DESKTOP_CPUS=1.8
DESKTOP_MEM_LIMIT=8g
SHM_SIZE=1g
